---
interface Props {
  buttonName?: string;
  awesomeIconClass?: string;
  buttonClass:
    | "signInBtn"
    | "mainHeaderBtn"
    | "expenseHeaderBtn"
    | "expenseHeaderEditBtn"
    | "expenseLineEditBtn"
    | "columnBtn"
    | "columnElementBtn"
    | "columnElementEditBtn"
    | "modalBtn"
    | "mobileActionBarBtn";
  buttonType: "button" | "submit";
  buttonId: string;
  active?: boolean;
}

const { buttonName, buttonClass, buttonId, buttonType, awesomeIconClass } =
  Astro.props;
---

<button
  type={buttonType}
  id={buttonId}
  class:list={[buttonClass, { active: Astro.props.active}]}
>
  <i class={awesomeIconClass}></i>{buttonName}
</button>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Amatic+SC&display=swap");
  button {
    display: flex;
    justify-content: center;
    align-items: center;
    min-width: fit-content;
    margin: 0 3%;
    background-color: aliceblue;
    border-radius: 10px;
    font-family: "Amatic SC", sans-serif;
    font-weight: bold;
  }

  .active {
    border: 2px solid black;
  }

  .signInBtn {
    font-size: 3.5rem;
    width: 20%;
  }

  .mainHeaderBtn {
    font-size: 1.6rem;
    width: 20%;
  }

  .expenseHeaderBtn {
    font-size: 1rem;
    width: 80%;
  }

  .expenseHeaderEditBtn {
    font-size: 1.7rem;
    width: fit-content;
  }

  .expenseLineEditBtn {
    font-size: 1.3rem;
    width: fit-content;
  }

  .columnBtn {
    font-size: 1.5rem;
    width: 80%;
  }

  .columnElementBtn {
    font-size: 1rem;
    width: 100%;
  }

  .columnElementEditBtn {
    font-size: 1rem;
    width: fit-content;
  }

  .modalBtn {
    font-size: 1.2rem;
    width: 50%;
  }

  .mobileActionBarBtn {
    font-size: 2rem;
    width: 100%;
    height: 100%;
  }

  @media screen and (max-width: 1020px) {
    html {
      font-size: 16px;
    }

    .mobileActionBarBtn {
    font-size: 1.6rem;
  }
  }
</style>

---
import Button from "../components/Button.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Popoupa!</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
  </head>
  <body>
    <header>
      <Button
        buttonType="button"
        buttonName="About Us!"
        buttonClass="mainHeaderBtn"
        buttonId="about-us-button"
      />
      <div id="logo" class="lightText"><a href="/"><h1>PoPoupa</h1></a></div>
      <Button
        buttonType="button"
        buttonName="Login! &#x1F512;"
        buttonClass="mainHeaderBtn"
        buttonId="login-button"
      />
    </header>
    <div id="main-space"><slot /></div>
  </body>
</html>
<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Amatic+SC&display=swap");

  html {
    background-color: #cf9f6e;
    z-index: -10;
    width: 100%;
    height: 100%;
    font-size: 18px;
  }

  header {
    display: flex;
    background-color: brown;
    height: 10%;
    border-radius: 10px;
    z-index: 10;
    justify-content: center;
    align-items: center;
    width: 100%;
    border: 1px solid black;
  }

  #logo {
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 2rem;
    flex-grow: 1;
    font-weight: bold;
    color: white;
  }

  #logo a {
    text-decoration: none;
    color: white;
  }

  #logo a:visited {
    text-decoration: none;
    color: white;
  }

  #logo h1 {
    margin: 0;
  }

  body {
    width: 90%;
    height: 100%;
    margin-left: 5%;
    margin-right: 5%;
    margin-top: 0%;
    margin-bottom: 0%;
    z-index: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
  }

  #main-space {
    width: 100%;
    height: 90%;
    border-radius: 10px;
    background-color: #652817;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  
  .darkText {
    font-family: "Amatic SC", sans-serif;
    color: black;
    font-weight: bolder;
  }

  .lightText {
    font-family: "Amatic SC", sans-serif;
    color: white;
    text-shadow:
      -1px -1px 0 black,
      1px -1px 0 black,
      -1px 1px 0 black,
      1px 1px 0 black;
  }
</style>

<script>
  let aboutUsButton = document.getElementById("about-us-button");
  aboutUsButton?.addEventListener("click", () => {
    window.location.href = "/aboutUs";
  });

  let loginButton = document.getElementById("login-button");
  loginButton?.addEventListener("click", () => {
    
  });
</script>

<script>
  function toggleDisplayFlexToNone(element: HTMLElement) {
    if (element.style.display === "flex" || element.style.display === "") {
      element.style.display = "none";
    } else {
      element.style.display = "flex";
    }
  }

  function toggleDisplayNoneToFlex(element: HTMLElement) {
    if (element.style.display === "none" || element.style.display === "") {
      element.style.display = "flex";
    } else {
      element.style.display = "none";
    }
  }

  const addSingleExpenseButtonSpace = document.getElementById(
    "group-line-add-expense-button-space"
  )!;
  const addBankStatementButtonSpace = document.getElementById(
    "group-line-add-bank-statement-button-space"
  )!;
  const editMultipleExpensesButtonSpace = document.getElementById(
    "group-line-edit-multiple-expenses-button-space"
  )!;
  const deleteMultipleExpensesButtonSpace = document.getElementById(
    "group-line-delete-multiple-expenses-button-space"
  )!;
  const renderMultipleExpensesEditingButton = document.getElementById(
    "render-edit-multiple-expenses-interface-button"
  )!;

  const editMultipleExpensesSubmitButton = document.getElementById(
    "submit-edit-multiple-expenses"
  )!;
  const deleteMultipleExpensesSubmitButton = document.getElementById(
    "delete-multiple-expenses"
  )!;
  const toEditMultipleExpensesCategoryId = document.getElementById(
    "expense-category-filter-select"
  )! as HTMLInputElement;

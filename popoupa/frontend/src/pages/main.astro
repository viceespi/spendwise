                          type="text"
                          name="ExpenseDescription"
                          id="expense-description"
                          value={expense.description}
                          placeholder={expense.description}
                          required
                        />
                        <label for="ExpenseDate" class="prettyLabel darkText">
                          Expense Date
                        </label>
                        <input
                          type="date"
                          name="ExpenseDate"
                          id="expense-date"
                          value={expenseMapper.getValidDateForEditing(
                            expense.date
                          )}
                          required
                        />
                        <label for="ExpenseAmount" class="prettyLabel darkText">
                          Expense Amount
                        </label>
                        <input
                          type="text"
                          name="ExpenseAmount"
                          id="expense-amount"
                          value={expense.amount}
                          placeholder={expenseMapper.getCurrencyAmount(
                            expense.amount
                          )}
                          required
                        />
                        <label
                          for="ExpenseGroupId"
                          class="prettyLabel darkText"
                        >
                          Expense Group
                        </label>
                        <select
                          name="ExpenseGroupId"
                          id="single-expense-group-select"

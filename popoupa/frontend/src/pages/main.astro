<!-- CLIENT SIDE RENDERING EXPENSE SHARING -->
<script>
  function toggleDisplayFlexToNone(element: HTMLElement) {
    if (element.style.display === "flex" || element.style.display === "") {
      element.style.display = "none";
    } else {
      element.style.display = "flex";
    }
  }

  function toggleDisplayNoneToFlex(element: HTMLElement) {
    if (element.style.display === "none" || element.style.display === "") {
      element.style.display = "flex";
    } else {
      element.style.display = "none";
    }
  }

  const stepOneHLabel = document.getElementById("step-one-label");
  const nextStepBtn = document.getElementById("next-step-share-expense")!;
  const prevStepBtn = document.getElementById("previous-step-share-expense")!;
  const friendListDiv = document.getElementById("friend-list-div")!;
  const stepOneElements = document.querySelectorAll(
    ".shareExpenseStepOne"
  )! as NodeListOf<HTMLInputElement>;
  const stepTwoElements = document.querySelectorAll(
    ".shareExpenseStepTwo"
  )! as NodeListOf<HTMLInputElement>;

  const toShareUsersCheckBoxes = document.querySelectorAll(
    ".userShareCheckBox"
  )! as NodeListOf<HTMLInputElement>;

  let toShareUsersIds: string[] = [];
  toShareUsersCheckBoxes.forEach((checkbox) => {
    if (checkbox.checked) {
      toShareUsersIds.push(checkbox.value);
    }
  });

  nextStepBtn.addEventListener("click", () => {
    if (toShareUsersIds.length > 0) {
      stepOneElements.forEach((div) => {
        toggleDisplayFlexToNone(div);
      });
      toggleDisplayFlexToNone(friendListDiv);
      stepTwoElements.forEach((divTwo) => {
        toggleDisplayNoneToFlex(divTwo);
      });
    }
    else {
      stepOneHLabel
    }
  });

  prevStepBtn.addEventListener("click", () => {
    stepTwoElements.forEach((divTwo) => {
      toggleDisplayFlexToNone(divTwo);
    });
    stepOneElements.forEach((divOne) => {
      toggleDisplayNoneToFlex(divOne);
    });
    toggleDisplayNoneToFlex(friendListDiv);
  });
</script>


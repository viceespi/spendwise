import UserLayout from "../layouts/UserLayout.astro";
import Button from "../components/Button.astro";
import ExpenseLine from "../components//ExpenseLine.astro";
import { ExpenseModelMapper } from "../lib/view-models/expense-model";
import { ExpenseService } from "../lib/services/expense-service";
import { GroupService } from "../lib/services/group-service";
import { CategoryService } from "../lib/services/category-service";
import { FilterService } from "../lib/services/filter-service";
import ModalButton from "../components/ModalButton.astro";
import { UserServices } from "../lib/services/user-service";
import type { User } from "../lib/models/user";
import NewGroupModal from "../components/NewGroupModal.astro";

const groupServices = new GroupService();
const expenseServices = new ExpenseService();
const categoryServices = new CategoryService();
const filterServices = new FilterService();
const expenseMapper = new ExpenseModelMapper();
const userServices = new UserServices();

var currentUser = await userServices.getCurrentUser();
var demoUser: User = {

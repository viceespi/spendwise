                  <hr />
                  {
                    groupsMapEntries.map(([groupId, group]) =>
                      group.id !== "all-elements" ? (
                        <option value={group.id}>{group.name}</option>
                      ) : null
                    )
                  }
                </select>
              </div>
              <div class="categorizationSelectSpace">
                <label for="ToEditExpensesCategoryId" class="darkText">
                  Category
                </label>
                <select
                  name="ToEditExpensesCategoryId"
                  id="expense-category-filter-select"
                >
                  <option value=""> No Changes!</option>
                  <hr />
                  {
                    categoriesMapEntries.map(([categoryId, category]) =>

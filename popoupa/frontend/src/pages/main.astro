};
var demoUser9: User = {
  userName: "Orion5",
  userEmail: "popocão@barkmail.com",
  userId: "0000002c-4657-4a3c-b4fc-3b713e2ba894",
};
var userFriendList: User[] = [
  demoUser1,
  demoUser2,
  demoUser3,
  demoUser4,
  demoUser5,
  demoUser6,
  demoUser7,
  demoUser8,
  demoUser9,
];

const groupsHashMap = await groupServices.getGroups(currentUser.userId);
const categoriesHashMap = await categoryServices.getCategories(
  currentUser.userId
);
const groupsMapEntries = Array.from(groupsHashMap.entries());
const categoriesMapEntries = Array.from(categoriesHashMap.entries());

const currentGroup = groupServices.getCurrentGroup(
  Astro.url.searchParams,
  groupsHashMap
);
const currentCategory = categoryServices.getCurrentCategory(
  Astro.url.searchParams,
  categoriesHashMap
);

const filter = filterServices.createFilter(Astro.url.searchParams);
const expenseHashMap = await expenseServices.getExpenseHashTable(
  filter,
  currentUser.userId
);
const expenseMapEntries = Array.from(expenseHashMap.entries());

if (Astro.request.method === "POST") {
  try {
    const currentQueryString = new URL(Astro.url).search;
    const formData = await Astro.request.formData();
    const formId = formData.get("FormId") as string;
    if (formId == "create-expense-form") {
      await expenseServices.createSingleExpense(
        formData,
        categoriesHashMap,
        groupsHashMap,
        currentUser.userId
      );
      return Astro.redirect(`/main${currentQueryString}`);
    } else if (formId === "add-bank-statement-form") {
      await expenseServices.createBankStatement(
        formData,
        categoriesHashMap,
        groupsHashMap,
        currentUser.userId
      );
      return Astro.redirect(`/main${currentQueryString}`);
    } else if (formId === "edit-single-expense-form") {
      await expenseServices.editSingleExpense(
        formData,
        categoriesHashMap,
        groupsHashMap,
        currentUser.userId
      );
      return Astro.redirect(`/main${currentQueryString}`);
    } else if (formId === "edit-multiple-expenses-form") {
      await expenseServices.editMultipleExpenses(
        formData,
        expenseHashMap,
        categoriesHashMap,
        groupsHashMap
      );
      return Astro.redirect(`/main${currentQueryString}`);
    } else if (formId === "delete-expense-form") {
      await expenseServices.deleteSingleExpense(formData);
      return Astro.redirect(`/main${currentQueryString}`);
    } else if (formId === "delete-multiple-expenses-form") {
      await expenseServices.deleteMultipleExpensesFromCheckBox(formData);
      return Astro.redirect(`/main${currentQueryString}`);
      6;
    } else if (formId === "create-new-group-form") {
      await groupServices.addNewGroup(formData, currentUser.userId);
      return Astro.redirect(`/main${currentQueryString}`);
    } else if (formId === "edit-group-form") {
      await groupServices.editGroup(formData);
      return Astro.redirect(`/main${currentQueryString}`);
    } else if (formId === "delete-group-and-expenses-form") {
      await expenseServices.deleteExpensesWithGroup(
        formData,
        currentUser.userId
      );
      await groupServices.deleteGroup(formData);
      return Astro.redirect("/main");
    } else if (formId === "delete-group-keep-expenses-form") {
      await expenseServices.resetExpensesGroup(formData, currentUser.userId);
      await groupServices.deleteGroup(formData);
      return Astro.redirect("/main");
    } else if (formId === "create-new-category-form") {
      await categoryServices.addNewCategory(formData, currentUser.userId);
      return Astro.redirect(`/main${currentQueryString}`);
    } else if (formId === "edit-category-form") {
      await categoryServices.editCategory(formData);
      return Astro.redirect(`/main${currentQueryString}`);
    } else if (formId === "delete-category-form") {
      await expenseServices.resetExpensesCategory(formData, currentUser.userId);
      await categoryServices.deleteCategory(formData);
      return Astro.redirect("/main");
    } else {
      return Astro.redirect(`/main${currentQueryString}`);
    }
  } catch (error) {
    console.log(error);
  }
}

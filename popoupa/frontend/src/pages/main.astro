<script>
  function toggleMobileRenderGroupsDiv(
    groupsDiv: HTMLElement,
    categoriesDiv: HTMLElement,
    mobileMainExpenseOptionDiv: HTMLElement,
    mainExpenseSpaceDiv: HTMLElement
  ) {
    if (groupsDiv.style.display === "none" || groupsDiv.style.display === "") {
      if (categoriesDiv.style.display === "flex") {
        categoriesDiv.style.display = "none";
      }
      if (mobileMainExpenseOptionDiv.style.display === "flex") {
        mobileMainExpenseOptionDiv.style.display = "none";
        expenseBoardDiv.style.order = "2";
        mobileMainExpenseOptionDiv.style.order = "1";
        expenseBoardDiv.style.height = "100%";
      }
      groupsDiv.style.display = "flex";
      groupsDiv.style.order = "3";
      categoriesDiv.style.order = "1";
      mainExpenseSpaceDiv.style.height = "40%";
    } else {
      groupsDiv.style.display = "none";
      groupsDiv.style.order = "1";
      categoriesDiv.style.order = "3";
      mainExpenseSpaceDiv.style.height = "80%";
    }
  }

  function toggleMobileRenderCategoryDiv(
    categoriesDiv: HTMLElement,
    groupsDiv: HTMLElement,
    mobileMainExpenseOptionDiv: HTMLElement,
    mainExpenseSpaceDiv: HTMLElement
  ) {
    if (
      categoriesDiv.style.display === "none" ||
      categoriesDiv.style.display === ""
    ) {
      if (groupsDiv.style.display === "flex") {
        groupsDiv.style.display = "none";
        groupsDiv.style.order = "1";
        categoriesDiv.style.order = "3";
      }
      if (mobileMainExpenseOptionDiv.style.display === "flex") {
        mobileMainExpenseOptionDiv.style.display = "none";
        expenseBoardDiv.style.order = "2";
        mobileMainExpenseOptionDiv.style.order = "1";
        expenseBoardDiv.style.height = "100%";
      }
      categoriesDiv.style.display = "flex";
      mainExpenseSpaceDiv.style.height = "40%";
    } else {
      categoriesDiv.style.display = "none";
      mainExpenseSpaceDiv.style.height = "80%";
    }
  }

  function toggleMobileRenderExpenseOptionsDiv(
    mobileMainExpenseOptionDiv: HTMLElement,
    groupsDiv: HTMLElement,
    categoriesDiv: HTMLElement,
    expenseBoardDiv: HTMLElement,
    mainExpenseSpaceDiv: HTMLElement
  ) {
    if (
      mobileMainExpenseOptionDiv.style.display === "none" ||
      mobileMainExpenseOptionDiv.style.display === ""
    ) {
      if (groupsDiv.style.display === "flex") {
        groupsDiv.style.display = "none";
        groupsDiv.style.order = "1";
        categoriesDiv.style.order = "3";
        mainExpenseSpaceDiv.style.height = "80%";
      }
      if (categoriesDiv.style.display === "flex") {
        categoriesDiv.style.display = "none";
        mainExpenseSpaceDiv.style.height = "80%";
      }
      expenseBoardDiv.style.order = "1";
      mobileMainExpenseOptionDiv.style.order = "2";
      expenseBoardDiv.style.height = "80%";
      mobileMainExpenseOptionDiv.style.height = "20%";
      mobileMainExpenseOptionDiv.style.display = "flex";
    } else {
      expenseBoardDiv.style.order = "2";
      mobileMainExpenseOptionDiv.style.order = "1";
      expenseBoardDiv.style.height = "100%";
      mobileMainExpenseOptionDiv.style.height = "10%";
      mobileMainExpenseOptionDiv.style.display = "none";
    }
  }

  const mobGroupsButton = document.getElementById("mobile-groups-button")!;
  const mobCategoriesButton = document.getElementById(
    "mobile-categories-button"
  )!;
  const mobExpenseOptionsButton = document.getElementById(
    "mobile-expense-options-button"
  )!;
  const groupsDiv = document.getElementById("groups-column")!;
  const categoriesDiv = document.getElementById("categories-column")!;
  const mobileMainExpenseOptionDiv = document.getElementById(
    "main-space-groups-line"
  )!;
  const mainExpenseCardDiv = document.getElementById(
    "main-space-expenses-card"
  )!;
  const expenseBoardDiv = document.getElementById("expense-board")!;

  mobGroupsButton.addEventListener("click", () => {
    toggleMobileRenderGroupsDiv(
      groupsDiv,
      categoriesDiv,
      mobileMainExpenseOptionDiv,
      mainExpenseCardDiv
    );
  });

  mobExpenseOptionsButton.addEventListener("click", () => {
    toggleMobileRenderExpenseOptionsDiv(
      mobileMainExpenseOptionDiv,
      groupsDiv,
      categoriesDiv,
      expenseBoardDiv,
      mainExpenseCardDiv
    );
  });

  mobCategoriesButton.addEventListener("click", () => {
    toggleMobileRenderCategoryDiv(
      categoriesDiv,
      groupsDiv,
      mobileMainExpenseOptionDiv,
      mainExpenseCardDiv
    );
  });

  console.log(window.innerWidth);
</script>


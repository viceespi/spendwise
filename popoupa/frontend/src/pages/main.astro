<!-- FILTER RESET SCRIPT -->
<script>
  let filterResetButton = document.getElementById("reset-filters-button");
  let expenseFilterForm = document.getElementById(
    "expense-filter-form"
  ) as HTMLFormElement;
  filterResetButton?.addEventListener("click", (event) => {
    for (let i = 1; i < expenseFilterForm!.children.length; i++) {
      let element = expenseFilterForm?.children[i] as HTMLFormElement;
      if (element.type === "text" || element.type === "date")
        element.value = "";
      else {
        element.value = "all-elements";
      }
    }
  });
</script>

<!-- BANKSTATEMENT SUBMISSION VALIDATION SCRIPT -->
<script>
  let bankStatementSubmitButton = document.getElementById(
    "submit-bank-statement"
  );
  let bankStatementFileInput = document.getElementById(
    "bank-statement-file"
  ) as HTMLInputElement;
  let bankStatementSubmitMessage = document.getElementById("file-state");
  let bankStatementType = document.getElementById(
    "bank-statement-select"
  ) as HTMLInputElement;

  bankStatementSubmitButton?.addEventListener("click", function (event) {
    const fileList = bankStatementFileInput.files;

    if (fileList?.length === 0 && bankStatementType.value == "") {
      bankStatementSubmitMessage!.textContent =
        "Please, select a file and its type to continue!";
      event.preventDefault();
    } else if (bankStatementType.value == "") {
      bankStatementSubmitMessage!.textContent =
        "Please, select the file type to continue!";
      event.preventDefault();
    } else if (fileList!.length === 0) {
      bankStatementSubmitMessage!.textContent =
        "Please, select a file to continue!";
      event.preventDefault();
    }
  });
</script>

<!-- SINGLE EXPENSE SUBMISSION VALIDATION SCRIPT -->
<script>
  let singleExpensePopoverValidationText = document.getElementById(
    "expense-creation-state"
  );
  let singleExpenseSubmitButton = document.getElementById(
    "submit-single-expense"
  );
  let singleExpenseInputDescription = document.getElementById(
    "expense-description"
  ) as HTMLInputElement;
  let singleExpenseInputDate = document.getElementById(
    "expense-date"
  ) as HTMLInputElement;
  let singleExpenseInputAmount = document.getElementById(
    "expense-amount"
  ) as HTMLInputElement;
  let singleExpenseInputCategory = document.getElementById(
    "expense-category"
  ) as HTMLInputElement;

  singleExpenseSubmitButton!.addEventListener("click", (event) => {
    if (
      singleExpenseInputDescription.value == "" ||
      singleExpenseInputDate.value == "" ||
      singleExpenseInputAmount.value == "" ||
      singleExpenseInputCategory.value == ""
    ) {
      singleExpensePopoverValidationText!.textContent =
        "You need to fill all the fields for submission!";
      event.preventDefault();
    }
  });
</script>


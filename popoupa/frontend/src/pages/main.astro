                    class="styleFormRow"
                    slot="containerSlot"
                  >
                    <ModalButton
                      awesomeIconClass="fa-solid fa-gear"
                      buttonId={`${expense.id}-edit-button`}
                      buttonClass="expenseLineEditBtn"
                      modalId={`${expense.id}-edit-button-modal`}
                      modalCloseButtonId={`${expense.id}-edit-button-modal-close`}
                      modalWidth="fit-content"
                    >
                      <form
                        method="POST"
                        enctype="multipart/form-data"
                        class="styleFormColumn"
                      >
                        <input
                          type="hidden"
                          name="FormId"
                          value="edit-single-expense-form"
                        />

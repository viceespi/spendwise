  renderMultipleExpensesEditingButton.addEventListener("click", () => {
    multipleExpensesCheckboxes.forEach((checkbox) => {
      if (checkbox.type === "checkbox") {
        checkbox.type = "hidden";
      } else {
        checkbox.type = "checkbox";
      }
    });
    toggleDisplayFlexToNone(addSingleExpenseButtonSpace);
    toggleDisplayFlexToNone(addBankStatementButtonSpace);
    toggleDisplayNoneToFlex(editMultipleExpensesButtonSpace);
    toggleDisplayNoneToFlex(deleteMultipleExpensesButtonSpace);
  });

  editMultipleExpensesSubmitButton.addEventListener("click", (event) => {
    debugger;
    event.preventDefault();
    const formData = new FormData();
    multipleExpensesCheckboxes.forEach((checkbox) => {
      if (checkbox.checked) {
        formData.append("SelectedExpenseId", checkbox.value);
      }
    });
    formData.append(
      "ToEditExpensesCategoryId",
      toEditMultipleExpensesCategoryId.value
    );
    formData.append(
      "ToEditExpensesGroupId",
      toEditMultipleExpensesGroupId.value
    );
    formData.append("FormId", "edit-multiple-expenses-form");

    fetch("http://localhost:4321/main", {
      method: "POST",
      body: formData,
    })
      .then((response) => {
        if (!response.ok) {
          throw new Error(
            "Network response not ok, no connection with astro server "
          );

        buttonId="create-new-group-open-modal-btn"
        buttonClass="columnBtn"
        buttonType="button">
        </Button>
        <NewGroupModal>
        </NewGroupModal>
      </div>
      <div class="groupAndCategorySpace">
        {
          groupsMapEntries.map(([groupId, group]) => (
            <div class="completeColumnItemSpace">
              <div class="columnItemButtonSpace">
                <form method="GET">
                  <input type="hidden" name="ExpenseGroupId" value={group.id} />
                  <input type="hidden" name="GroupName" value={group.name} />
                  <input
                    type="hidden"
                    name="CategoryName"
                    value={
                      Astro.url.searchParams.get("CategoryName") === null
                        ? "All Expenses"
                        : (Astro.url.searchParams.get("CategoryName") as string)
                    }
                  />
                  <input
                    type="hidden"
                    name="ExpenseCategoryId"
                    value={
                      Astro.url.searchParams.get("ExpenseCategoryId") === null
                        ? "all-elements"
                        : (Astro.url.searchParams.get(
                            "ExpenseCategoryId"
                          ) as string)
                    }
                  />
                  <Button
                    buttonType="submit"
                    buttonName={group.name}
                    buttonId={`${group.id}-button`}
                    buttonClass="columnElementBtn"
                    active={group.id === currentGroup.id}
                  />
                </form>
              </div>
              {groupId !== "all-elements" &&
              groupId !== "00000000-0000-0000-0000-000000000000" ? (
                <div class="columnItemEditOptionsSpace columnGroupEditOptionsSpace">
                  <ModalButton
                    awesomeIconClass="fa-solid fa-gear"
                    buttonId={`edit-${groupId}-group-button`}
                    buttonClass="columnElementEditBtn"
                    modalId={`edit-${groupId}-group-modal`}
                    modalCloseButtonId={`edit-${groupId}-group-modal-close-button`}
                    modalWidth="fit-content"
                  >
                    <form
                      method="POST"
                      enctype="multipart/form-data"
                      class="styleFormColumn"
                      name="EditGroupForm"
                    >
                      <input
                        type="hidden"
                        name="FormId"
                        value="edit-group-form"
                      />
                      <label for="EditGroupForm" class="darkText">
                        Edit your Group!
                      </label>
                      <label for="GroupName" class="darkText">
                        Group Name
                      </label>
                      <input
                        type="text"
                        name="GroupName"
                        id="group-name"
                        value={group.name}
                        placeholder={group.name}
                        required
                      />
                      <input type="hidden" name="GroupId" value={groupId} />
                      <Button
                        buttonType="submit"
                        buttonName="Submit"
                        buttonId="edit-group-submit-button"
                        buttonClass="modalBtn"
                      />
                    </form>
                  </ModalButton>
                  <ModalButton
                    awesomeIconClass="fa-solid fa-trash"
                    buttonId={`${groupId}-delete-group-options-button`}
                    buttonClass="columnElementEditBtn"
                    modalId={`${groupId}-delete-group-options-modal`}
                    modalCloseButtonId={`${groupId}-delete-group-options-modal-close-button`}
                    modalWidth="fit-content"
                  >
                    <form method="POST" enctype="multipart/form-data">
                      <input
                        type="hidden"
                        name="FormId"
                        value="delete-group-and-expenses-form"
                      />
                      <input type="hidden" name="GroupId" value={groupId} />
                      <Button
                        buttonName="Delete Expenses!"
                        buttonId="delete-group-with-expenses-button"
                        buttonClass="modalBtn"
                        buttonType="submit"
                      />
                    </form>
                    <form method="POST" enctype="multipart/form-data">
                      <input
                        type="hidden"
                        name="FormId"
                        value="delete-group-keep-expenses-form"
                      />
                      <input type="hidden" name="GroupId" value={groupId} />
                      <Button
                        buttonName="Keep Expenses!"
                        buttonId="delete-group-keep-expenses-button"
                        buttonClass="modalBtn"
                        buttonType="submit"
                      />
                    </form>
                  </ModalButton>

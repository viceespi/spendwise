              <label for="ExpenseDescription" class="prettyLabel darkText">
                Expense Description
              </label>
              <input
                type="text"
                name="ExpenseDescription"
                id="expense-description"
                required
              />
              <label for="ExpenseDate" class="prettyLabel darkText">
                Expense Date
              </label>
              <input
                type="date"
                name="ExpenseDate"
                id="expense-date"
                required
              />
              <label for="ExpenseAmount" class="prettyLabel darkText">
                Expense Amount
              </label>
              <input
                type="text"
                name="ExpenseAmount"
                id="expense-amount"
                required
              />
              <label for="ExpenseGroupId" class="prettyLabel darkText">
                Expense Group</label
              >
              <select
                name="ExpenseGroupId"
                id="single-expense-group-select"
                required
              >
                {
                  groupsMapEntries.map(([groupId, group]) =>
                    groupId === "all-elements" ? null : (
                      <option value={groupId}>{group.name}</option>
                    )
                  )
                }
              </select>
              <label for="ExpenseCategoryId" class="prettyLabel darkText">
                Expense Category</label
              >
              <select
                name="ExpenseCategoryId"
                id="single-expense-category-select"
                required
              >
                {
                  categoriesMapEntries.map(([categoryId, category]) =>
                    category.id !== "all-elements" ? (
                      <option value={category.id}>{category.name}</option>
                    ) : null
                  )
                }
              </select>

              <p id="expense-creation-state" class="prettyLabel darkText">
                Please fill all the fields!
              </p>
              <Button
                buttonType="submit"
                buttonName="Submit"
                buttonId="submit-single-expense"
                buttonClass="modalBtn"
              />
            </form>
          </ModalButton>
        </div>

        <div
          class="groupLineElement"
          id="group-line-add-bank-statement-button-space"
        >
          <ModalButton
            buttonName="Add Bank Statement"
            buttonId="add-bank-statement"
            buttonClass="expenseHeaderBtn"
            modalId="add-bank-statement-modal"
            modalCloseButtonId="add-bank-statement-modal-close"
            modalWidth="fit-content"
          >
            <form
              method="POST"
              enctype="multipart/form-data"
              class="styleFormColumn"
            >
              <input
                type="hidden"
                name="FormId"
                value="add-bank-statement-form"
              />
              <label
                for="bank-statement-popover-content"
                class="prettyLabel darkText">Submit Bank Statement!</label
              >
              <label for="BankStatementFile" class="prettyLabel darkText"
                >Select Bank Statement</label
              >
              <input
                type="file"
                multiple="false"
                name="BankStatementFile"
                id="bank-statement-file"
                accept=".csv,.pdf"
                required
              />
              <label for="BankStatementType" class="prettyLabel darkText">
                Select Bank Statement type!
              </label>
              <select
                name="BankStatementType"
                id="bank-statement-select"
                required
              >
                <option value=""> Select a type</option>
                <hr />
                <optgroup label="Nubank"> </optgroup>
                <option value="nubank_csv">Débito</option>
                <option value="nubank_pdf">Crédito</option>
              </select>
              <label for="BankStatementGroup" class="prettyLabel darkText">
                Select the Group of all expenses in the Bank Statement!
              </label>
              <select
                name="BankStatementGroup"
                id="bank-statement-category-select"
                required
              >
                {
                  groupsMapEntries.map(([groupId, group]) =>
                    group.id !== "all-elements" ? (
                      <option value={group.id}>{group.name}</option>
                    ) : null
                  )
                }
              </select>
              <label for="BankStatementCategory" class="prettyLabel darkText">
                Select the Category of all expenses in the Bank Statement!
              </label>
              <select
                name="BankStatementCategory"
                id="bank-statement-category-select"
                required
              >
                {
                  categoriesMapEntries.map(([categoryId, category]) =>
                    category.id !== "all-elements" ? (
                      <option value={category.id}>{category.name}</option>
                    ) : null
                  )
                }
              </select>
              <label
                for="BankStatementMonthOfReference"
                class="prettyLabel darkText"
              >
                Select the month of reference!
              </label>
              <select
                name="BankStatementMonthOfReference"
                id="bank-statement-month-of-reference-select"
                required
              >
                <option value="1">Jan</option>
                <option value="2">Feb</option>
                <option value="3">Mar</option>
                <option value="4">Apr</option>
                <option value="5">May</option>
                <option value="6">Jun</option>
                <option value="7">Jul</option>
                <option value="8">Aug</option>
                <option value="9">Sep</option>
                <option value="10">Oct</option>
                <option value="11">Nov</option>
                <option value="12">Dec</option>
              </select>

              <p id="file-state" class="darkText">
                Please select the file and its type!
              </p>
              <Button
                buttonType="submit"
                buttonName="Submit"
                buttonId="submit-bank-statement"
                buttonClass="modalBtn"
              />
            </form>
          </ModalButton>
        </div>


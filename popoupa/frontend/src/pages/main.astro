              ) : null}
            </div>
          ))
        }
      </div>
      <div class="editColumnElementsButtonSpace">
        <Button
          buttonName="Edit Groups!"
          buttonId="edit-groups-button"
          buttonClass="columnBtn"
          buttonType="button"
        />
      </div>
    </div>
    <div class="groupLineElement mobileRenderElement" id="mobile-group-line">
      <div class="groupLineElement" id="group-line-current-group-space">
        <h1 class="lightText">{currentGroup.name}</h1>
      </div>
    </div>
    <div id="main-space-expenses-card">
      <div id="main-space-groups-line">
        <div
          class="groupLineElement webRenderElement"
          id="group-line-current-group-space"
        >
          <h1 class="lightText">{currentGroup.name}</h1>
        </div>

        <div class="groupLineElement" id="group-line-add-expense-button-space">
          <ModalButton
            buttonName="Add 1 Expense"
            buttonId="add-expense"
            buttonClass="expenseHeaderBtn"
            modalId="add-expense-modal"
            modalCloseButtonId="add-expense-modal-close"
            modalWidth="fit-content"
          >
            <form
              method="POST"
              enctype="multipart/form-data"
              class="styleFormColumn"
            >
              <input type="hidden" name="FormId" value="create-expense-form" />
              <label for="expense-popover-content" class="prettyLabel darkText"
                >Create Expense!</label
